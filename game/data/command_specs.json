    "category": "系统",
    "usage": "帮助",
    "guards": [],
    "order": 1
  },
  "game_tip": {
    "patterns": [
      "^(?:\\[At:[^\\]]+\\]\\s*)?(?:游戏提示|提示)(?:\\s*|$)"
