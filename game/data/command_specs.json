  "shortcut_trigger": {
    "patterns": [
      "^(?:\\[At:[^\\]]+\\]\\s*)?(?!gm_)(?!help(?:\\s|$))(?![+＋\\-－＝=@\\[/])(?:[0-9０-９]\\d*|[a-zA-Z][a-zA-Z0-9]*|[^\\s0-9０-９a-zA-Z\\u4e00-\\u9fff])[\\s\\S]*$"
    ],
    "desc": "数字/字母开头消息 → 查快捷绑定并转发执行",
    "category": "系统",
    "usage": "（发绑定的数字，如 1）",
    "order": 7,
    "extra": {
      "note": "v105 P1/P2 + v123b/c 触发放宽：任意位数字全量匹配（绑『13』发『13』，不拆 1+3）；字母开头前缀匹配 + 后缀透传（绑『n 前往』发『n3』=前往 3）；单字符符号键前缀匹配 + 后缀透传（绑『. 攻击』发『.3』=攻击 3；中文汉字键不支持，避免吞掉全部中文指令）。负向前瞻排除：内置英文指令（gm_/help）、翻页快捷键（+－-=＝）、At/引用前缀（@[/）。"
    }
  },
