{
  "weekly_cmd": {
    "patterns": [
      "^(?:\\[At:[^\\]]+\\]\\s*)?周常(?!列表)(?:\\s*|$)"
    ],
    "desc": "查看本周悬赏（本周首查自动发布 3 条）",
