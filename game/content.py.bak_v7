# ============================================================
# 九、掉落权重表（按怪物角色模板）
# ============================================================
def roll_drop(monster_lv: int, role: str):
    """怪物死亡掉落：返回 (装备或None, 材料名或None, 金币, 经验)
    掉落品质权重随等级提升：等级越高，高品质装备概率越大
    """
    quality_weights = {"白": 60, "绿": 25, "蓝": 10, "紫": 4, "橙": 1}
    # 精英/首领提高高品质权重
    if role == "elite":
        quality_weights = {"白": 30, "绿": 30, "蓝": 22, "紫": 13, "橙": 5}
    elif role == "boss":
        quality_weights = {"白": 10, "绿": 20, "蓝": 30, "紫": 25, "橙": 15}
    # 等级每高 5 级，高品质略增
    bonus = min(monster_lv // 10, 5)
    for q in ["紫", "橙"]:
        quality_weights[q] = min(quality_weights[q] + bonus, 30)
    quality = random.choices(list(quality_weights.keys()), weights=list(quality_weights.values()))[0]
    # 25% 概率掉落装备（首领 100%）
    drop_chance = 1.0 if role == "boss" else (0.35 if role == "elite" else 0.25)
    equip = None
    if random.random() < drop_chance:
        slot = random.choice(["weapon", "helm", "armor", "legs", "boots", "ring", "necklace"])
        equip = generate_equip(slot, monster_lv, quality)
    return equip


def generate_equip(slot: str, lv: int, quality: str, weapon_type: str | None = None):
    """生成一件装备（名称 + 属性）"""
    if slot == "weapon":
        if not weapon_type:
            weapon_type = random.choice(list(WEAPON_TYPES.keys()))
        base_name = EQUIP_NAME_PREFIX[quality][random.randrange(len(EQUIP_NAME_PREFIX[quality]))]
        suffix = random.choice(["之刃", "之杖", "之弓", "之锤"])
        name = f"{base_name}{suffix}"
        if quality == "橙":
            name = f"传说·{base_name}{suffix}"
    else:
        prefix = EQUIP_NAME_PREFIX[quality][random.randrange(len(EQUIP_NAME_PREFIX[quality]))]
        suffix = random.choice(EQUIP_NAME_SUFFIX[slot])
        name = f"{prefix}{suffix}"
    stats = equip_stats(slot, lv, quality)
    return {
        "name": name,
        "slot": slot,
        "quality": quality,
        "lv": lv,
        "weapon_type": weapon_type if slot == "weapon" else None,
        "stats": stats,
        "price": int(sum(stats.values()) * (3 + lv * 0.5) * QUALITY[quality]["mult"]),
    }


def build_monster(monster_def: tuple, map_obj: dict):
    """将地图怪物配置展开为完整怪物字典"""
    mid, name, role, lv, skills, drops = monster_def
    stats = monster_stats(lv, role)
    is_boss = role == "boss"
    is_elite = role == "elite"
    return {
        "id": mid,
        "name": name,
        "lv": lv,
        "role": role,
        "hp": stats["hp"],
        "max_hp": stats["hp"],
        "atk": stats["atk"],
        "def": stats["def"],
        "matk": stats["matk"],
        "mdef": stats["mdef"],
        "spd": stats["spd"],
        "exp": monster_exp(lv, role),
        "gold": monster_gold(lv, role),
        "skills": skills,
        "drops": drops,
        "map": map_obj["name"],
        "map_area": map_obj.get("area", map_obj["id"]),
        "is_boss": is_boss,
        "is_elite": is_elite,
    }


