    {'id': 'divine_path', 'name': '天穹之路', 'lv': 91, 'region': '神域', 'chapter': 6, 'area': 'divine_gate', 'area_name': '神域之门', 'desc': '通往神域的天穹之路，云海在脚下翻涌。天穹守卫们驻守在阶梯两侧，目光望向天空的尽头。', 'type': '野外', 'shop': False, 'healer': False, 'hidden': False, 'monsters': [('m_sky_guard', '天穹守卫', 'tank', 91, ['圣光斩', '天罚', '盾击'], ['天穹护甲']), ('m_astral_messenger', '星界使者', 'caster', 92, ['天罚', '圣光斩', '魔法飞弹'], ['星界之尘']), ('m_divine_warrior', '神域战灵', 'dps', 93, ['圣光斩', '天罚', '神威'], ['神域战魂'])], 'elite': ('e_astral_knight', '星界骑士长', 'elite', 94, ['圣光斩', '天罚', '神威', '圣光冲锋'], ['星界骑士剑']), 'boss': None, 'npcs': []},
    {'id': 'divine_hall', 'name': '星界回廊', 'lv': 93, 'region': '神域', 'chapter': 6, 'area': 'divine_gate', 'area_name': '神域之门', 'desc': '星界回廊，群星的墓地。星界贤者们在此守护着诸神陨落前的最后记忆。', 'type': '野外', 'shop': True, 'healer': True, 'hidden': False, 'monsters': [('m_astral_sage', '星界贤者', 'caster', 93, ['天罚', '暴风雪', '神威'], ['星界法珠']), ('m_divine_warrior', '神域战灵', 'dps', 93, ['圣光斩', '天罚', '神威'], ['神域战魂'])], 'elite': ('e_astral_judge', '星界裁决者', 'elite', 95, ['天罚', '神威', '创世之力'], ['星界裁决之杖']), 'boss': None, 'npcs': ['npc_star_warden']},
