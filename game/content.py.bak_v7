# 怪物技能 → 等级段限制（低等级怪只用基础技能）
def monster_skills_pool(lv: int):
    """按等级返回可选技能池（越高等级技能越丰富）"""
    if lv <= 5:
        return ["撕咬", "爪击", "冲撞", "劈砍", "魔法飞弹"]
    if lv <= 10:
        return ["撕咬", "爪击", "冲撞", "劈砍", "重击", "毒咬", "火球", "嚎叫", "魔法飞弹"]
    if lv <= 15:
        return ["撕咬", "爪击", "重击", "劈砍", "毒咬", "火球", "闪电箭", "暗影箭", "怒吼", "战吼", "汲取", "哀嚎"]
    if lv <= 20:
        return ["重击", "劈砍", "盾击", "毒咬", "冰咬", "火球", "闪电箭", "暗影箭", "汲取", "狂暴", "招魂", "吞噬", "腐息"]
    if lv <= 25:
        return ["重击", "盾击", "火球", "闪电箭", "暗影箭", "虚空斩", "灼烧", "雷击", "风刃", "霜息", "暴风雪", "狂暴", "地狱火"]
    if lv <= 45:
        return ["重击", "盾击", "火球", "闪电箭", "暗影箭", "虚空斩", "灼烧", "雷击", "风刃", "霜息", "暴风雪", "狂暴", "地狱火", "暗影风暴", "灭世", "符文爆发", "先祖之怒", "秘银震击", "龙之怒", "风暴召唤", "圣光斩", "天罚", "神威"]
    if lv <= 65:
        return ["重击", "盾击", "火球", "闪电箭", "暗影箭", "虚空斩", "灼烧", "雷击", "风刃", "霜息", "暴风雪", "狂暴", "地狱火", "暗影风暴", "灭世", "符文爆发", "先祖之怒", "秘银震击", "龙之怒", "风暴召唤", "圣光斩", "天罚", "神威", "混沌侵蚀", "虚空崩塌"]
    if lv <= 85:
        return ["重击", "盾击", "火球", "闪电箭", "暗影箭", "虚空斩", "灼烧", "雷击", "风刃", "霜息", "暴风雪", "狂暴", "地狱火", "暗影风暴", "灭世", "符文爆发", "先祖之怒", "秘银震击", "龙之怒", "风暴召唤", "圣光斩", "天罚", "神威", "混沌侵蚀", "虚空崩塌", "湮灭射线", "吞噬虚空"]
    return ["重击", "盾击", "火球", "闪电箭", "暗影箭", "虚空斩", "灼烧", "雷击", "风刃", "霜息", "暴风雪", "狂暴", "地狱火", "暗影风暴", "灭世", "符文爆发", "先祖之怒", "秘银震击", "龙之怒", "风暴召唤", "圣光斩", "天罚", "神威", "混沌侵蚀", "虚空崩塌", "湮灭射线", "吞噬虚空", "混沌领域", "创世之力"]

