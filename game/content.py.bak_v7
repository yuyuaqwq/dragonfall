    {'id': 'elf_courtyard', 'name': '月之庭院', 'lv': 44, 'region': '神域边境', 'chapter': 4, 'area': 'elf_court', 'area_name': '精灵王庭', 'desc': '精灵王庭的月之庭院，银月泉水依旧流淌，但守护它的精灵法师们眼中只剩空洞。', 'type': '野外', 'shop': True, 'healer': False, 'hidden': False, 'monsters': [('m_elf_mage', '精灵法师', 'caster', 44, ['火球', '闪电箭'], ['精灵法珠']), ('m_jade_bird', '翠羽灵鸟', 'speedster', 45, ['俯冲', '风刃'], ['翠羽'])], 'elite': ('e_court_guard', '王庭禁卫', 'elite', 46, ['劈砍', '风刃', '盾击'], ['王庭徽章']), 'boss': None, 'npcs': ['npc_elf_sage']},
    {'id': 'elf_throne', 'name': '王庭深处', 'lv': 48, 'region': '神域边境', 'chapter': 4, 'area': 'elf_court', 'area_name': '精灵王庭', 'desc': '精灵王庭的最深处，月神祭坛上，女王的身影被暗影笼罩。她手中的月之泪，已化为黑色。', 'type': '核心', 'shop': False, 'healer': False, 'hidden': False, 'monsters': [('m_court_guard', '王庭禁卫', 'tank', 48, ['劈砍', '风刃', '盾击'], ['王庭徽章']), ('m_elf_mage', '精灵法师', 'caster', 47, ['火球', '闪电箭'], ['精灵法珠'])], 'elite': ('e_moon_priest', '月神祭司', 'elite', 49, ['魔法飞弹', '暴风雪', '自然祝福'], ['月之泪']), 'boss': ('b_elf_queen', '精灵女王·艾薇安', 'boss', 50, ['风刃', '暴风雪', '自然祝福', '天罚'], ['月神之冠']), 'npcs': []},
    {'id': 'dragon_path', 'name': '龙脊山道', 'lv': 51, 'region': '神域边境', 'chapter': 4, 'area': 'dragon_ridge', 'area_name': '龙脊山脉', 'desc': '龙脊山脉的蜿蜒山道，灼热的气浪从山巅翻涌而下。龙裔战士在山道间巡逻，警惕地盯着每个闯入者。', 'type': '野外', 'shop': False, 'healer': False, 'hidden': False, 'monsters': [('m_dragon_lizard', '龙鳞蜥蜴', 'tank', 51, ['撕咬', '龙之怒'], ['龙鳞']), ('m_cliff_wyvern', '岩脊飞龙', 'speedster', 52, ['俯冲', '龙之怒'], ['飞龙翼']), ('m_dragonkin', '龙裔战士', 'dps', 53, ['劈砍', '龙之怒', '战吼'], ['龙裔徽记'])], 'elite': ('e_dragon_warrior', '龙脉战士长', 'elite', 54, ['重击', '龙之怒', '战吼'], ['龙脉战刃']), 'boss': None, 'npcs': []},
    {'id': 'dragon_nest', 'name': '龙巢之巅', 'lv': 54, 'region': '神域边境', 'chapter': 4, 'area': 'dragon_ridge', 'area_name': '龙脊山脉', 'desc': '龙巢之巅，幼龙们在巢穴间嬉戏，却带着不属于幼龙的暴戾。贤者岩语说，龙血正在被某种力量唤醒。', 'type': '野外', 'shop': True, 'healer': False, 'hidden': False, 'monsters': [('m_ember_whelp', '赤炎幼龙', 'caster', 54, ['火球', '龙之怒'], ['龙炎精华']), ('m_dragonkin', '龙裔战士', 'dps', 53, ['劈砍', '龙之怒', '战吼'], ['龙裔徽记'])], 'elite': ('e_dragon_guardian', '龙脉守护者', 'elite', 56, ['龙之怒', '烈焰震击', '战吼'], ['龙脉护符']), 'boss': None, 'npcs': ['npc_dragon_elder']},
    {'id': 'dragon_shrine', 'name': '万龙圣殿', 'lv': 58, 'region': '神域边境', 'chapter': 4, 'area': 'dragon_ridge', 'area_name': '龙脊山脉', 'desc': '万龙圣殿，龙族的圣地。龙王·奥瑞斯盘踞在王座上，龙眼中燃烧着不属于龙族的混沌之火。', 'type': '核心', 'shop': False, 'healer': False, 'hidden': False, 'monsters': [('m_flame_wyvern', '赤炎飞龙', 'dps', 58, ['火球', '龙之怒', '俯冲'], ['飞龙鳞']), ('m_dragon_guardian', '龙脉守护者', 'tank', 57, ['龙之怒', '烈焰震击', '战吼'], ['龙脉护符'])], 'elite': ('e_dragon_wing', '龙翼亲卫', 'elite', 59, ['龙之怒', '圣光冲锋', '战吼'], ['龙翼剑']), 'boss': ('b_dragon_king', '龙王·奥瑞斯', 'boss', 60, ['龙之怒', '烈焰震击', '狂暴', '吞噬'], ['龙王之角']), 'npcs': []},
    {'id': 'void_edge', 'name': '裂隙边缘', 'lv': 61, 'region': '深渊外围', 'chapter': 5, 'area': 'void_rift', 'area_name': '虚空裂隙', 'desc': '虚空裂隙的边缘地带，空间在这里扭曲成漩涡。虚空蠕虫在裂隙间蠕动，发出令人牙酸的嘶鸣。', 'type': '野外', 'shop': False, 'healer': False, 'hidden': False, 'monsters': [('m_void_worm', '虚空蠕虫', 'speedster', 61, ['撕咬', '虚空斩'], ['虚空粘液']), ('m_rift_wraith', '裂隙魔灵', 'caster', 62, ['暗影箭', '虚空斩'], ['裂隙碎片']), ('m_void_minion', '虚空爪牙', 'dps', 63, ['爪击', '虚空斩'], ['虚空之爪'])], 'elite': ('e_void_ripper', '虚空撕裂者', 'elite', 64, ['虚空斩', '暗影风暴', '吞噬'], ['撕裂者核心']), 'boss': None, 'npcs': []},
    {'id': 'void_corridor', 'name': '虚空长廊', 'lv': 64, 'region': '深渊外围', 'chapter': 5, 'area': 'void_rift', 'area_name': '虚空裂隙', 'desc': '虚空长廊，无数破碎的世界在此重叠。虚空守望者悬浮在长廊两侧，空洞的眼眶注视着每一个过客。', 'type': '野外', 'shop': True, 'healer': False, 'hidden': False, 'monsters': [('m_void_watcher', '虚空守望者', 'tank', 64, ['重击', '虚空斩', '盾击'], ['虚空护甲']), ('m_rift_wraith', '裂隙魔灵', 'caster', 63, ['暗影箭', '虚空斩'], ['裂隙碎片'])], 'elite': ('e_void_lord', '虚空领主', 'elite', 66, ['虚空斩', '虚空崩塌', '暗影风暴'], ['虚空领主印记']), 'boss': None, 'npcs': ['npc_void_prophet']},
    {'id': 'void_heart', 'name': '虚空之心', 'lv': 68, 'region': '深渊外围', 'chapter': 5, 'area': 'void_rift', 'area_name': '虚空裂隙', 'desc': '虚空裂隙的核心，一颗巨大的暗紫色心脏在虚空中跳动。虚空巨像们守护着它——那是吞噬者的心脏。', 'type': '核心', 'shop': False, 'healer': False, 'hidden': False, 'monsters': [('m_void_colossus', '虚空巨像', 'tank', 68, ['重击', '虚空崩塌', '吞噬'], ['虚空巨像核心']), ('m_void_watcher', '虚空守望者', 'tank', 67, ['重击', '虚空斩', '盾击'], ['虚空护甲'])], 'elite': ('e_void_overlord', '虚空主宰', 'elite', 69, ['虚空崩塌', '暗影风暴', '吞噬'], ['虚空主宰权杖']), 'boss': ('b_void_devourer', '虚空吞噬者', 'boss', 70, ['虚空斩', '虚空崩塌', '吞噬', '暗影风暴'], ['吞噬者之核']), 'npcs': []},
    {'id': 'temple_hall', 'name': '圣殿前厅', 'lv': 71, 'region': '深渊外围', 'chapter': 5, 'area': 'dark_temple', 'area_name': '黑暗圣殿', 'desc': '黑暗圣殿的前厅，曾经供奉光明神的殿堂如今爬满暗影。黑暗修士们低声吟唱着亵渎的祷词。', 'type': '野外', 'shop': False, 'healer': False, 'hidden': False, 'monsters': [('m_dark_acolyte', '黑暗修士', 'caster', 71, ['暗影箭', '汲取'], ['黑暗经卷']), ('m_abyss_servant', '深渊仆从', 'dps', 72, ['爪击', '暗影箭'], ['深渊之尘']), ('m_fallen_paladin', '堕落圣骑', 'tank', 73, ['劈砍', '暗影箭', '盾击'], ['堕落圣徽'])], 'elite': ('e_inquisitor', '审判官', 'elite', 74, ['暗影箭', '死亡之握', '暗影风暴'], ['审判官之印']), 'boss': None, 'npcs': []},
    {'id': 'temple_aisle', 'name': '忏悔回廊', 'lv': 74, 'region': '深渊外围', 'chapter': 5, 'area': 'dark_temple', 'area_name': '黑暗圣殿', 'desc': '忏悔回廊，两侧是无数忏悔室的残骸。被囚禁的灵魂在此徘徊，发出永无止境的哀叹。', 'type': '野外', 'shop': True, 'healer': False, 'hidden': False, 'monsters': [('m_penitent_wraith', '忏悔亡灵', 'caster', 74, ['哀嚎', '暗影箭'], ['忏悔之泪']), ('m_abyss_priest', '深渊牧师', 'caster', 75, ['暗影箭', '汲取', '死亡之握'], ['深渊法珠'])], 'elite': ('e_heresy_executor', '异端处刑者', 'elite', 76, ['重击', '暗影箭', '暗影风暴'], ['处刑者之斧']), 'boss': None, 'npcs': ['npc_fallen_priest']},
    {'id': 'temple_altar', 'name': '深渊祭坛', 'lv': 78, 'region': '深渊外围', 'chapter': 5, 'area': 'dark_temple', 'area_name': '黑暗圣殿', 'desc': '深渊祭坛，教团献祭的中心。祭坛之上，深渊教宗正在举行召唤仪式——他在召唤深渊真正的主人。', 'type': '核心', 'shop': False, 'healer': False, 'hidden': False, 'monsters': [('m_abyss_ritualist', '深渊祭祀', 'caster', 78, ['暗影箭', '地狱火', '死亡之握'], ['祭祀之火']), ('m_heresy_executor', '异端处刑者', 'dps', 77, ['重击', '暗影箭', '暗影风暴'], ['处刑者之斧'])], 'elite': ('e_archpriest', '教团大祭司', 'elite', 79, ['地狱火', '暗影风暴', '死亡之握'], ['大祭司之环']), 'boss': ('b_abyss_pope', '深渊教宗', 'boss', 80, ['地狱火', '暗影风暴', '死亡之握', '混沌侵蚀'], ['教宗权杖']), 'npcs': []},
    {'id': 'annih_front', 'name': '荒芜前线', 'lv': 81, 'region': '深渊外围', 'chapter': 5, 'area': 'annihilation', 'area_name': '湮灭平原', 'desc': '湮灭平原的前线阵地，大地被烧成焦黑。湮灭魔兵列成方阵，灾厄骑士的铁蹄震动着荒芜的地面。', 'type': '野外', 'shop': False, 'healer': False, 'hidden': False, 'monsters': [('m_annih_soldier', '湮灭魔兵', 'dps', 81, ['重击', '湮灭射线', '狂暴'], ['湮灭碎片']), ('m_doom_knight', '灾厄骑士', 'tank', 82, ['重击', '湮灭射线', '盾击'], ['灾厄战甲']), ('m_soul_devourer', '噬魂者', 'caster', 83, ['汲取', '湮灭射线', '哀嚎'], ['噬魂结晶'])], 'elite': ('e_annih_vanguard', '湮灭先锋', 'elite', 84, ['湮灭射线', '狂暴', '暗影风暴'], ['先锋战旗']), 'boss': None, 'npcs': []},
    {'id': 'annih_field', 'name': '湮灭战场', 'lv': 84, 'region': '深渊外围', 'chapter': 5, 'area': 'annihilation', 'area_name': '湮灭平原', 'desc': '湮灭战场，尸骸遍野，破碎的旗帜在风中摇曳。湮灭魔将们在此督战，等待总攻的命令。', 'type': '野外', 'shop': True, 'healer': False, 'hidden': False, 'monsters': [('m_annih_general', '湮灭魔将', 'dps', 84, ['湮灭射线', '虚空斩', '狂暴'], ['魔将之刃']), ('m_doom_knight', '灾厄骑士', 'tank', 83, ['重击', '湮灭射线', '盾击'], ['灾厄战甲'])], 'elite': ('e_annih_lord', '湮灭领主', 'elite', 86, ['湮灭射线', '虚空崩塌', '狂暴'], ['湮灭领主之环']), 'boss': None, 'npcs': ['npc_annih_spy']},
