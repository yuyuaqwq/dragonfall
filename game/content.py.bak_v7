# -*- coding: utf-8 -*-
"""
《剑与魔法》游戏内容库 v2.0 —— 公式驱动，策划支持 100 级
============================================================
架构说明：
- 怪物/装备属性全部由【公式 + 模板】生成，不手写每条数据
- 新增地图 = 在 MAPS 加一行；新增怪物 = 在模板池选型
- 当前实现 1-30 级内容（第 1-3 篇章），31-100 级按同架构扩展
世界观：维斯特兰大陆 —— 六大势力交错，剑与魔法并行。
"""

import random

# ============================================================
# 〇、基础数值公式（策划核心）
# ============================================================
def monster_stats(lv: int, role: str) -> dict:
    """怪物属性公式：按等级 + 角色模板生成。
    role: tank(血牛) / dps(攻高) / caster(魔攻) / speedster(敏捷) / boss(首领) / elite(精英)
    """
    base = {
        "tank":       {"hp": 60,  "atk": 8,  "def": 7,  "matk": 3,  "mdef": 6,  "spd": 6},
        "dps":        {"hp": 45,  "atk": 12, "def": 4,  "matk": 4,  "mdef": 4,  "spd": 10},
        "caster":     {"hp": 40,  "atk": 5,  "def": 3,  "matk": 14, "mdef": 8,  "spd": 9},
        "speedster":  {"hp": 35,  "atk": 9,  "def": 3,  "matk": 5,  "mdef": 4,  "spd": 16},
        "elite":      {"hp": 95,  "atk": 14, "def": 8,  "matk": 10, "mdef": 8,  "spd": 11},
        "boss":       {"hp": 160, "atk": 16, "def": 10, "matk": 12, "mdef": 10, "spd": 10},
    }[role]
    growth = {
        "tank":       {"hp": 14,  "atk": 1.1, "def": 1.0, "matk": 0.5, "mdef": 0.9, "spd": 0.2},
        "dps":        {"hp": 9,   "atk": 1.6, "def": 0.7, "matk": 0.6, "mdef": 0.6, "spd": 0.8},
        "caster":     {"hp": 7,   "atk": 0.6, "def": 0.5, "matk": 1.8, "mdef": 1.1, "spd": 0.7},
        "speedster":  {"hp": 6,   "atk": 1.2, "def": 0.5, "matk": 0.6, "mdef": 0.6, "spd": 1.4},
        "elite":      {"hp": 20,  "atk": 1.8, "def": 1.2, "matk": 1.4, "mdef": 1.2, "spd": 0.9},
        "boss":       {"hp": 38,  "atk": 2.2, "def": 1.5, "matk": 1.8, "mdef": 1.4, "spd": 1.0},
    }[role]
    stats = {}
    for k in base:
        stats[k] = int(base[k] + growth[k] * (lv - 1))
    # 首领/精英血量系数按等级段放大，保证后期 Boss 有压迫感
    if role == "boss":
        stats["hp"] = int(stats["hp"] * (1 + lv * 0.06))
    if role == "elite":
        stats["hp"] = int(stats["hp"] * (1 + lv * 0.04))
    return stats


def equip_stats(slot: str, lv: int, quality: str) -> dict:
    """装备属性公式：部位 + 装备等级 + 品质 → 属性字典"""
    mult = QUALITY[quality]["mult"]
    base = {
        "weapon":   {"atk": 3,  "matk": 3},
        "helm":     {"def": 2,  "hp": 8},
        "armor":    {"def": 4,  "hp": 15},
        "legs":     {"def": 3,  "hp": 10},
        "boots":    {"def": 1,  "spd": 2},
        "ring":     {"atk": 1,  "matk": 1},
        "necklace": {"mdef": 2, "hp": 6},
    }[slot]
    scaling = {
        "weapon":   {"atk": 2.0, "matk": 2.0},
        "helm":     {"def": 1.0, "hp": 6},
        "armor":    {"def": 1.8, "hp": 12},
        "legs":     {"def": 1.3, "hp": 8},
        "boots":    {"def": 0.8, "spd": 1.0},
        "ring":     {"atk": 0.7, "matk": 0.7},
        "necklace": {"mdef": 1.2, "hp": 5},
    }[slot]
    stats = {}
    for k in base:
        stats[k] = int((base[k] + scaling[k] * lv) * mult)
    if slot in ("weapon", "ring") and quality in ("蓝", "紫", "橙"):
        stats["crit"] = round((0.02 + 0.01 * lv / 10) * (QUALITY[quality]["mult"] - 1), 3)
    if slot == "necklace" and quality in ("蓝", "紫", "橙"):
        stats["mdef"] += int(3 * mult)
    return stats


def exp_to_next(level: int) -> int:
    """升到下一级所需经验（100级可扩展）"""
    return int(35 * level ** 1.45 + 25)


def monster_exp(lv: int, role: str) -> int:
    """怪物经验公式"""
    base = {"tank": 10, "dps": 11, "caster": 12, "speedster": 11, "elite": 30, "boss": 90}[role]
    return int(base * (1 + lv * 0.9))


def monster_gold(lv: int, role: str) -> int:
    """怪物金币公式"""
    base = {"tank": 5, "dps": 6, "caster": 6, "speedster": 6, "elite": 20, "boss": 60}[role]
    return int(base * (1 + lv * 0.6))


