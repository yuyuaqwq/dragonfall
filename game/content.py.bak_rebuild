    "奥术Ⅰ": "学徒", "奥术Ⅱ": "符文", "奥术Ⅲ": "秘法", "奥术Ⅳ": "星界", "奥术Ⅴ": "星辰",
    "疾风Ⅰ": "猎手", "疾风Ⅱ": "风行", "疾风Ⅲ": "暗夜", "疾风Ⅳ": "鹰眼", "疾风Ⅴ": "苍穹",
    "圣辉Ⅰ": "布衣", "圣辉Ⅱ": "祝福", "圣辉Ⅲ": "圣堂", "圣辉Ⅳ": "审判", "圣辉Ⅴ": "神恩",
    "暗影Ⅰ": "轻影", "暗影Ⅱ": "夜行", "暗影Ⅲ": "阴影", "暗影Ⅳ": "幻影", "暗影Ⅴ": "午夜",
    "金刚Ⅰ": "行者", "金刚Ⅱ": "铁手", "金刚Ⅲ": "虎啸", "金刚Ⅳ": "磐石", "金刚Ⅴ": "金身",
}
# v45 命名迁移合并进统一映射（main.py 加载存档时用 C.SET_RENAME 迁移）
SET_RENAME.update(SET_RENAME_CLASS)

# v45 装备名迁移：旧装备名 → 新装备名（老玩家背包/装备栏名称迁移用）
# v41 格式：铁血Ⅰ胸甲 / 铁血Ⅰ之剑 / 铁血Ⅰ图纸（前缀+罗马数字+部位/之+武器类型/图纸）
# v44 格式：戍卫胸甲 / 戍卫之剑 / 戍卫图纸（套名+部位/之+武器类型/图纸）
# v45 格式：铁皮胸甲 / 粗制铁剑 / 铁皮图纸（套名+部位 / 独立武器名 / 套名+图纸）
ITEM_RENAME = {}
_OLD_PART_SUFFIX = ["头盔", "胸甲", "护腿", "战靴"]  # v41/v44 防具部位后缀统一
for _old_set, _new_set in SET_RENAME_CLASS.items():
    # 找新套名对应职业（v45 主题），推导新防具部位后缀 + 新武器名
    _cls_theme = next((t for t in CLASS_SET_THEMES.values() if _new_set in t["stages"]), None)
    if _cls_theme is None:
        continue
    _idx = _cls_theme["stages"].index(_new_set)
    # 防具：旧「套名+头盔/胸甲/护腿/战靴」→ 新「套名+职业部位后缀」
    for _i, _old_part in enumerate(_OLD_PART_SUFFIX):
        ITEM_RENAME[f"{_old_set}{_old_part}"] = f"{_new_set}{_cls_theme['parts'][_i]}"
    # 武器：旧「套名+之+武器类型」→ 新独立武器名
    ITEM_RENAME[f"{_old_set}之{_cls_theme['wtype']}"] = _cls_theme["weapons"][_idx]
    # 图纸：旧「套名+图纸」→ 新「套名+图纸」
    ITEM_RENAME[f"{_old_set}图纸"] = f"{_new_set}图纸"
# v45a 微调迁移：v45 上线期间已获得的「旧影/苦行/旧猎弓/旧权杖/生锈匕首/旧拳套」装备名
ITEM_RENAME.update({
    "旧影面巾": "轻影面巾", "旧影皮衣": "轻影皮衣", "旧影护腿": "轻影护腿", "旧影轻靴": "轻影轻靴",
    "旧影图纸": "轻影图纸", "生锈匕首": "粗制匕首",
    "苦行头带": "行者头带", "苦行僧袍": "行者僧袍", "苦行护腿": "行者护腿", "苦行布靴": "行者布靴",
    "苦行图纸": "行者图纸", "旧拳套": "粗布拳套",
    "旧猎弓": "粗制猎弓", "旧权杖": "粗制权杖",
})
# 职业毕业套生成：注入 CRAFT_RECIPES + SETS（import 时自动执行）
def _build_class_sets():
    for cls, theme in CLASS_SET_THEMES.items():
        for idx, st in enumerate(CLASS_SET_STAGES):
            lv = st["lv"]
            label = st["label"]
            prefix = theme["stages"][idx]
            # 套装效果注册（同阶段各职业套名唯一）
            SETS[prefix] = {
                "quality": st["quality"], "icon": theme["icon"],
                "bonus_2": theme["bonus_2"], "bonus_4": theme["bonus_4"],
            }
            # 5 件套配方：独立武器名 + 防具（套名+职业部位后缀）
            parts = [
                ("weapon", theme["wtype"], theme["weapons"][idx]),
                ("helm",   None,        f"{prefix}{theme['parts'][0]}"),
                ("armor",  None,        f"{prefix}{theme['parts'][1]}"),
                ("legs",   None,        f"{prefix}{theme['parts'][2]}"),
                ("boots",  None,        f"{prefix}{theme['parts'][3]}"),
            ]
            for slot, wtype, name in parts:
                if name in CRAFT_RECIPES:
                    continue  # 防重复
                CRAFT_RECIPES[name] = {
                    "slot": slot, "quality": st["quality"], "lv": lv,
                    "weapon_type": wtype, "mats": dict(st["mats"]),
                    "gold": st["gold"],
                    "blueprint": f"{prefix}图纸",
                    "class": cls, "set": prefix,
                    "desc": f"{cls}毕业套·{label}（{prefix}）核心部件",
                }
_build_class_sets()


# ============================================================
# 十六、装备附魔（enchant）—— v10
# ============================================================
# 附魔槽：蓝 1 槽 / 紫 2 槽 / 橙 2 槽（白/绿无附魔）
ENCHANT_SLOTS = {"蓝": 1, "紫": 2, "橙": 2}
# 附魔配方：消耗 1 个匹配材料 + 金币 → 附加一条属性（数值 = 白板基础 * ratio）
# mats: 材料名关键词（背包材料名含任一即匹配）
ENCHANT_RECIPES = {
    "atk":  {"label": "攻击", "mats": ["核心", "獠牙", "爪", "之刃", "权杖", "战刃", "剑"], "ratio": 0.18, "cost": 500},
    "matk": {"label": "魔攻", "mats": ["法珠", "法杖", "结晶", "经卷", "法球"], "ratio": 0.18, "cost": 500},
    "def":  {"label": "防御", "mats": ["皮", "甲", "壳", "盾牌", "铠"], "ratio": 0.18, "cost": 400},
    "mdef": {"label": "魔防", "mats": ["徽章", "羽毛", "护符", "圣印", "之羽"], "ratio": 0.18, "cost": 400},
    "hp":   {"label": "生命", "mats": ["精华", "血肉", "腐肉", "之心", "粘液", "之泪"], "ratio": 0.20, "cost": 350},
    "spd":  {"label": "速度", "mats": ["羽", "翼", "翎羽", "蹄"], "ratio": 0.16, "cost": 450},
    "crit": {"label": "暴击", "mats": ["碎片", "之尘", "图腾", "棱镜"], "ratio": 0.02, "cost": 800},
}
ENCHANT_CRIT_CHANCE = 0.05   # 大成功概率（数值 1.5x）
ENCHANT_MAX_VALUE = {"crit": 0.04, "dodge": 0.03}  # crit/dodge 类附魔上限（防叠乘）


def enchant_value(slot: str, lv: int, stat: str, big: bool = False) -> int | float:
    """附魔数值：白板基础 * ratio；大成功 1.5x；crit/dodge 固定小值"""
    rec = ENCHANT_RECIPES.get(stat)
    if not rec:
        return 0
    if stat in ("crit", "dodge"):
        v = rec["ratio"]
    else:
        base = equip_stats(slot, lv, "白").get(stat, 0)
        if base <= 0:
            base = _affix_base_value(slot, lv, stat)
        v = max(1, int(base * rec["ratio"]))
    if big:
        v = v * 1.5
        if stat in ("crit", "dodge"):
            v = round(v, 3)
    if stat in ENCHANT_MAX_VALUE:
        v = min(v, ENCHANT_MAX_VALUE[stat])
    return v


def enchant_match_material(stat: str, items: list) -> str | None:
    """从背包物品里找第一个匹配该附魔系的材料名（无则 None）"""
    rec = ENCHANT_RECIPES.get(stat)
    if not rec:
        return None
    for it in items:
        d = it.get("data", {})
        if d.get("type") != "材料":
            continue
        name = d.get("name", "")
        if any(kw in name for kw in rec["mats"]):
            return name
    return None


# ============================================================
# 十六-B、符文系统（rune）—— v33/v34（MC 附魔书思路）
# ============================================================
# 符文是消耗品（type="符文"），用『附魔 <装备> <符文名>』给装备附加独特效果。
# 每种符文 = 一个独特效果（不只是加数值，还有机制），高品质更强。
# 符文带等级 I/II/III：同效果不同等级强度不同，掉落随机等级，高等级更稀有。
# 冲突机制：RUNE_CONFLICTS 里互斥的效果不能共存于同一件装备（附魔槽有限 + 冲突 = 配装题）。
#
# 效果字段（战斗引擎按 effect 结算）：
#   brutal        残忍：暴击伤害 +30/50/80%（乘算，暴击流核心）
#   armor_pierce  破甲：攻击无视 20/30/40% 防御
#   burn          灼热：攻击附带灼烧 1/2/3 层
#   lifesteal     吸血：造成伤害的 5/8/12% 回复生命
#   freeze        冰霜：攻击 10/15/20% 概率冻结敌人 1 回合
#   swift         疾风：速度 +8/12/18%
#   barrier       壁垒：受击时 15/25/35% 概率获得护盾（8/10/15% 生命值）
#   regen         治愈：每回合回复 1/2/3% 生命
#   chain         连锁：攻击 10/15/20% 概率额外雷击（70/100/140% 攻击伤害）
#   weaken        虚弱：攻击附带敌人攻击 -10/15/20%（3 回合）
#   thorns        荆棘：受击反弹 10/15/20% 伤害
#   scavenger     拾荒：金币掉落 +15/25/40%
#   exp_bless     睿智：经验获取 +10/15/25%
#   ironwall      铁壁：防御 +8/12/18%
#   mana_flow     聚能：MP 消耗 -10/15/25%
#   magic_break   破魔：对魔防高的敌人增伤（魔法伤害 +10/15/20%）
RUNES = {
    # 攻击系
    "残忍":   {"quality": "史诗", "effect": "brutal", "lvl": {1: 0.30, 2: 0.50, 3: 0.80}, "desc": "暴击伤害 +{v}%", "cost": 1500, "icon": "💢"},
    "破甲":   {"quality": "史诗", "effect": "armor_pierce", "lvl": {1: 0.20, 2: 0.30, 3: 0.40}, "desc": "攻击无视 {v}% 防御", "cost": 1500, "icon": "🗡️"},
    "灼热":   {"quality": "稀有", "effect": "burn", "lvl": {1: 1, 2: 2, 3: 3}, "desc": "攻击附带灼烧 {v} 层", "cost": 800, "icon": "🔥"},
    "冰霜":   {"quality": "稀有", "effect": "freeze", "lvl": {1: 0.10, 2: 0.15, 3: 0.20}, "desc": "攻击 {v}% 概率冻结敌人", "cost": 900, "icon": "❄️"},
    "连锁":   {"quality": "传说", "effect": "chain", "lvl": {1: (0.10, 0.70), 2: (0.15, 1.00), 3: (0.20, 1.40)}, "desc": "攻击 {v1}% 概率雷击 {v2}% 伤害", "cost": 2200, "icon": "⚡"},
    "虚弱":   {"quality": "稀有", "effect": "weaken", "lvl": {1: 0.10, 2: 0.15, 3: 0.20}, "desc": "攻击使敌人攻击 -{v}%（3回合）", "cost": 900, "icon": "😵"},
    "破魔":   {"quality": "史诗", "effect": "magic_break", "lvl": {1: 0.10, 2: 0.15, 3: 0.20}, "desc": "魔法伤害 +{v}%", "cost": 1400, "icon": "🔮"},
    # 生存系
    "吸血":   {"quality": "史诗", "effect": "lifesteal", "lvl": {1: 0.05, 2: 0.08, 3: 0.12}, "desc": "造成伤害的 {v}% 回复生命", "cost": 1200, "icon": "🩸"},
    "治愈":   {"quality": "史诗", "effect": "regen", "lvl": {1: 0.01, 2: 0.02, 3: 0.03}, "desc": "每回合回复 {v}% 生命", "cost": 2000, "icon": "✨"},
    "壁垒":   {"quality": "传说", "effect": "barrier", "lvl": {1: (0.15, 0.08), 2: (0.25, 0.10), 3: (0.35, 0.15)}, "desc": "受击 {v1}% 概率获得 {v2}% 护盾", "cost": 2500, "icon": "🛡️"},
    "荆棘":   {"quality": "史诗", "effect": "thorns", "lvl": {1: 0.10, 2: 0.15, 3: 0.20}, "desc": "受击反弹 {v}% 伤害", "cost": 1600, "icon": "🌵"},
    # 属性系
    "疾风":   {"quality": "稀有", "effect": "swift", "lvl": {1: 0.08, 2: 0.12, 3: 0.18}, "desc": "速度 +{v}%", "cost": 800, "icon": "💨"},
    "铁壁":   {"quality": "稀有", "effect": "ironwall", "lvl": {1: 0.08, 2: 0.12, 3: 0.18}, "desc": "防御 +{v}%", "cost": 850, "icon": "🏰"},
    "聚能":   {"quality": "稀有", "effect": "mana_flow", "lvl": {1: 0.10, 2: 0.15, 3: 0.25}, "desc": "MP 消耗 -{v}%", "cost": 950, "icon": "🌀"},
    # 收益系
    "拾荒":   {"quality": "稀有", "effect": "scavenger", "lvl": {1: 0.15, 2: 0.25, 3: 0.40}, "desc": "金币掉落 +{v}%", "cost": 1000, "icon": "💰"},
    "睿智":   {"quality": "稀有", "effect": "exp_bless", "lvl": {1: 0.10, 2: 0.15, 3: 0.25}, "desc": "经验获取 +{v}%", "cost": 1000, "icon": "📖"},
}

# 符文冲突：同件装备不能共存的效果对（火冰不相容、受击反应二选一、收益系二选一等）
RUNE_CONFLICTS = [
    ("burn", "freeze"),          # 灼热 vs 冰霜：火冰不相容
    ("barrier", "thorns"),       # 壁垒 vs 荆棘：受击反应二选一
    ("scavenger", "exp_bless"),  # 拾荒 vs 睿智：经济流二选一
]

# 符文品质 → 掉落权重（打怪概率掉落，品质越高越稀有）
RUNE_DROP = {"稀有": 0.018, "史诗": 0.008, "传说": 0.0025}

# 符文效果中文名（战斗日志/详情展示用）
RUNE_EFFECT_NAMES = {
    "brutal": "残忍", "armor_pierce": "破甲", "burn": "灼热", "lifesteal": "吸血",
    "freeze": "冰霜", "swift": "疾风", "barrier": "壁垒", "regen": "治愈",
    "chain": "连锁", "weaken": "虚弱", "thorns": "荆棘", "scavenger": "拾荒",
    "exp_bless": "睿智", "ironwall": "铁壁", "mana_flow": "聚能", "magic_break": "破魔",
}

# 等级罗马数字
RUNE_LEVEL_ROMAN = {1: "I", 2: "II", 3: "III"}

# 兼容旧名（v33 叫附魔石，v34 定名符文）
ENCHANT_STONES = RUNES
ENCHANT_STONE_DROP = RUNE_DROP
ENCHANT_EFFECT_NAMES = RUNE_EFFECT_NAMES


def rune_value(effect: str, lvl: int):
    """符文效果数值：effect + 等级 → 数值（用于战斗结算）"""
    for name, r in RUNES.items():
        if r["effect"] == effect:
            return r["lvl"].get(lvl, r["lvl"].get(1, 0))
    return 0


def rune_conflict(effect_a: str, effect_b: str) -> bool:
    """两个符文效果是否冲突（同件装备不能共存）"""
    if effect_a == effect_b:
        return False
    for (x, y) in RUNE_CONFLICTS:
        if (effect_a == x and effect_b == y) or (effect_a == y and effect_b == x):
            return True
    return False


def rune_item(effect: str, lvl: int = 1) -> dict:
    """构造符文物品 data（掉落/奖励用）"""
    for name, r in RUNES.items():
        if r["effect"] == effect:
            lv = min(3, max(1, lvl))
            roman = RUNE_LEVEL_ROMAN[lv]
            desc = r["desc"]
            if "{" in desc:
                try:
                    if "v1" in desc:
                        v1, v2 = r["lvl"][lv]
                        desc = desc.format(v1=int(v1 * 100), v2=int(v2 * 100))
                    else:
                        v = r["lvl"][lv]
                        if isinstance(v, float) and v < 1:
                            v = int(v * 100)
                        desc = desc.format(v=v)
                except Exception:
                    pass
            return {
                "name": f"{r['quality']}符文·{name} {roman}",
                "type": "符文",
                "effect": effect,
                "lvl": lv,
                "quality": r["quality"],
                "price": r["cost"] // 2,
                "desc": desc,
            }
    return None


