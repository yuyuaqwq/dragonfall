    {"name": "水草", "type": "垃圾", "price": 1, "desc": "缠成一团的水草，什么也没有"},
]
FISH_WEIGHTS = [35, 25, 15, 10, 6, 4, 3, 2]  # 与 FISH_POOL 对应


def roll_fish():
    """钓鱼结果：返回 FISH_POOL 中的一项"""
    return random.choices(FISH_POOL, weights=FISH_WEIGHTS, k=1)[0]


