# ============================================================
# 八、任务（主线 10 章 + 支线 + 每日）
# 任务类型 objective：
#   {"kill": 怪物名, "count": N}        击杀指定怪物
#   {"collect": 材料名, "count": N}     收集指定材料（交任务时扣除）
#   {"explore": 地图id}                  到达指定子区域
# ============================================================
MAIN_QUESTS = [
    {"id": "q1", "name": "初出茅庐", "giver": "npc_mayor", "desc": "在维拉镇外围击败 5 只野狗，为镇长解决商队之患", "objective": {"kill": "野狗", "count": 5}, "reward_exp": 80, "reward_gold": 30, "next": "q2", "story": "镇长·阿尔文将一张皱巴巴的悬赏令推到你面前：『近来西境商路不太平，野狗群在城门外结伴游荡，吓跑了三支商队。老夫腿脚不便，小友若是愿意替镇子跑这一趟，酬劳好说。』", "ending": "你提着沾血的剑回到广场。镇长抚须大笑：『好样的！商队能进城了。不过……德鲁伊姐妹传来消息，翡翠森林的圣鹿发狂了，怕是有更邪门的东西在作祟。』"},
    {"id": "q2", "name": "森林的呼唤", "giver": "npc_druid", "desc": "前往翡翠森林之心，击败远古圣鹿，净化被侵蚀的森林", "objective": {"kill": "远古圣鹿", "count": 1}, "reward_exp": 200, "reward_gold": 80, "next": "q3", "story": "森林边缘，德鲁伊·艾拉拦住你，神色凝重：『远古圣鹿本是森林的守护者，如今却双目赤红、见人便撞。森林深处的腐气在蔓延，你若能净化它，翡翠森林会记住你的名字。』", "ending": "圣鹿倒下时，森林的雾气散开了一角。艾拉拾起一片染血的鹿角，低声说：『腐气没有消失，它在向地下渗透——矮人的矿洞，怕是出事了。』"},
    {"id": "q3", "name": "矿洞危机", "giver": "npc_dwarf_elder", "desc": "深入矿洞深处，击败隧洞之王，夺回矮人的矿脉", "objective": {"kill": "隧洞之王", "count": 1}, "reward_exp": 400, "reward_gold": 150, "next": "q4", "story": "矿洞口，矮人长老·铜须拄着镐头，胡须气得直颤：『隧洞之王那帮黑皮占了我们祖传的矿脉，挖通了不该挖的东西！你帮老矮子夺回矿脉，秘银管够！』", "ending": "隧洞之王轰然倒地。铜须望着矿道深处幽绿的微光，声音发颤：『那……那不是矿脉的光。矿工说在底下听见了亡灵的呜咽。沼泽那边，怕是已经烂透了。』"},
    {"id": "q4", "name": "沼泽的诅咒", "giver": "npc_mayor", "desc": "前往幽暗沼泽之心，击败腐朽领主，破除亡灵诅咒", "objective": {"kill": "腐朽领主", "count": 1}, "reward_exp": 700, "reward_gold": 250, "next": "q5", "story": "镇长·阿尔文这次没有笑：『幽暗沼泽的腐朽领主把整片沼泽变成了尸场，瘟疫顺着地下水往镇子方向爬。孩子，这是诅咒，不是野兽。你要小心。』", "ending": "腐朽领主的骸骨散落在腐泥中。你感到脚下的大地在轻颤——仿佛有什么更庞大的东西，在赤脊山脉的另一头苏醒了。"},
    {"id": "q5", "name": "赤脊之敌", "giver": "npc_orc_prisoner", "desc": "击败战歌部落酋长，解放被暴政压迫的兽人", "objective": {"kill": "战歌部落酋长", "count": 1}, "reward_exp": 1000, "reward_gold": 400, "next": "q6", "story": "兽人囚犯·血牙隔着牢栏望着你，声音沙哑：『酋长疯了，他拿族人的血向深渊献祭，换来的力量把我们变成了奴隶。你若能斩下他的头颅，兽人欠你一条命。』", "ending": "战歌酋长的战旗在血火中倒下。血牙单膝跪地：『从今往后，兽人绝不与西境为敌。但你最好快些去东边——黑石城的巫妖宰相，正在把死人挖出来当兵用。』"},
    {"id": "q6", "name": "死城复仇", "giver": "npc_ghost_knight", "desc": "击败巫妖宰相，为旧王国复仇", "objective": {"kill": "巫妖宰相", "count": 1}, "reward_exp": 1500, "reward_gold": 600, "next": "q7", "story": "黑石城废墟，幽灵骑士·加文的身影半透明，铠甲上还插着生锈的箭：『巫妖宰相用瘟疫夺走了我的王，我的国，我的命。百年了，我一直在等一个活人来替我挥剑。』", "ending": "巫妖宰相的魂匣碎成齑粉。加文的幽灵第一次露出了笑：『谢谢你……我的王可以安息了。但深渊的火从未熄灭——熔岩核心的暴君，正在为它打造新的盔甲。』"},
    {"id": "q7", "name": "烈焰试炼", "giver": "npc_mayor", "desc": "前往熔岩核心，击败熔岩暴君", "objective": {"kill": "熔岩暴君", "count": 1}, "reward_exp": 2200, "reward_gold": 900, "next": "q8", "story": "熔岩谷口，热浪扑面。镇长·阿尔文捎来的信被烤得卷边：『熔岩暴君苏醒了，它每踏一步，大地就裂开一道口子。你若不去，西境将变成火海。』", "ending": "熔岩暴君的核心冷却成黑石。你刚松了口气，北境的寒鸦衔来一片冰晶——上面刻着霜裔亚龙的爪印，和一行求救的符文。"},
    {"id": "q8", "name": "极北寒冰", "giver": "npc_mayor", "desc": "前往冰霜洞穴，击败霜裔亚龙", "objective": {"kill": "霜裔亚龙", "count": 1}, "reward_exp": 3200, "reward_gold": 1300, "next": "q9", "story": "暴风雪中，北境猎人·冰须缩在皮袄里递给你一块冰封的鳞片：『霜裔亚龙把整条冰脉冻成了它的巢穴，商路全断了。那畜生连雪怪都吃，你小心点。』", "ending": "霜裔亚龙的冰翼碎成漫天雪屑。风暴稍歇，你望见极北之巅的雷云中，矗立着一座从未出现在任何地图上的高塔——风暴巨人王的王座。"},
    {"id": "q9", "name": "雷暴之上", "giver": "npc_sky_hermit", "desc": "在风暴之巅击败风暴巨人王，登上世界之巅", "objective": {"kill": "风暴巨人王", "count": 1}, "reward_exp": 4500, "reward_gold": 1800, "next": "q10", "story": "风暴之巅，云海翻涌。隐士·云游者站在雷暴中却毫发无伤：『风暴巨人王看守着天穹的钥匙，据说那是封印深渊的最后一道锁。他若倒戈，天就塌了。』", "ending": "风暴巨人王的雷锤坠入云海。云游者凝视天际：『锁，已经开了。深渊的大门在暗影之城下轰然作响——魔王·阿兹莫丹，醒了。』"},
    {"id": "q10", "name": "魔王讨伐", "giver": "npc_mayor", "desc": "击败魔王·阿兹莫丹，终结深渊的威胁！", "objective": {"kill": "魔王·阿兹莫丹", "count": 1}, "reward_exp": 10000, "reward_gold": 5000, "next": None, "story": "暗影之城王座前，最后的守军已经拼光了。你握紧武器，对面传来低沉的笑声：『又来一个送死的凡人。也好，我正缺一具能承受深渊之力的躯壳。』", "ending": "魔王·阿兹莫丹的身躯崩解成黑雾，却在消散前狂笑：『我只是先锋！真正的主人在深渊之下……你们的世界，已经在它掌心了！』黑雾散去，你看见远境大教堂的方向，圣光正在熄灭。"},
    {'id': 'q11', 'name': '远境的呼唤', 'giver': 'npc_holy_cardinal', 'desc': '远境祭坛的圣光被侵蚀，击败远境骑士长，查明真相', 'objective': {'kill': '远境骑士长', 'count': 1}, 'reward_exp': 6000, 'reward_gold': 2500, 'next': 'q12', 'story': "远境大教堂，红衣主教·圣辉脸色惨白：『祭坛的圣光被什么东西啃食了，骑士长带人查看后……就再也没回来。他的剑还插在祭坛上，剑刃却是黑的。』", 'ending': "远境骑士长倒下时，头盔里滚出的不是头颅，而是一团蠕动的暗影。圣辉主教颤抖着在胸前画了个符号：『赛拉斯……大主教赛拉斯，他一直站在那团暗影里。』"},
    {'id': 'q12', 'name': '大教堂的阴影', 'giver': 'npc_holy_cardinal', 'desc': '大主教·赛拉斯已经堕落，击败他，净化远境大教堂', 'objective': {'kill': '大主教·赛拉斯', 'count': 1}, 'reward_exp': 8000, 'reward_gold': 3500, 'next': 'q13', 'story': "大教堂深处的阴影里，大主教·赛拉斯缓缓转身，声音平静得可怕：『你以为你战胜了魔王？不。深渊从不正面进攻，它只是……借我的手，打开圣光的后门。』", 'ending': "赛拉斯倒在圣坛前，最后的话像叹息：『太迟了……精灵之森的月泉，已经被我污染了。去吧，去听那些树的哭声。』"},
    {'id': 'q13', 'name': '精灵之森的叹息', 'giver': 'npc_elf_sage', 'desc': '前往精灵之森，聆听精灵王庭的求救', 'objective': {'explore': 'elf_forest'}, 'reward_exp': 10000, 'reward_gold': 4000, 'next': 'q14', 'story': "精灵之森入口，树人老迈的枝干上挂满泪痕：『月泉枯了，精灵女王·艾薇安把自己关在王庭里，谁也不见。她曾经是月光的女儿，现在却怕见月光。』", 'ending': "王庭的大门在你面前缓缓开启。月光透过叶隙洒下，你听见王庭深处传来一声压抑的哭泣——那是女王的声音。"},
    {'id': 'q14', 'name': '月之哀歌', 'giver': 'npc_elf_sage', 'desc': '精灵女王·艾薇安被暗影侵蚀，击败她，夺回月之泪', 'objective': {'kill': '精灵女王·艾薇安', 'count': 1}, 'reward_exp': 13000, 'reward_gold': 5000, 'next': 'q15', 'story': "精灵王庭，月影摇曳。精灵女王·艾薇安背对着你，肩头微微颤抖：『月之泪被暗影夺走，我控制不住体内的黑暗……杀了我，趁我还记得自己是精灵。』", 'ending': "月之泪在女王消散的身影中凝成实体，落入你掌心。最后的月光洒在王庭，树人长老轻声道：『龙脊山脉在震动……古龙们，醒了。』"},
    {'id': 'q15', 'name': '龙脊的试炼', 'giver': 'npc_dragon_elder', 'desc': '龙血正在被唤醒，击败龙脉守护者，获得龙族的认可', 'objective': {'kill': '龙脉守护者', 'count': 1}, 'reward_exp': 16000, 'reward_gold': 6500, 'next': 'q16', 'story': "龙脊山巅，龙裔长老·奥兰多化作人形，鳞甲上布满裂痕：『龙血被唤醒，龙脉守护者陷入疯狂。你若能平息它的怒火，龙族愿意告诉你深渊的真相。』", 'ending': "龙脉守护者伏下身躯，金色的龙瞳恢复清明。奥兰多低头行礼：『真相在龙眠圣殿，古龙·奥瑞斯在那里等你——它是唯一经历过上一次深渊战争的活见证。』"},
    {'id': 'q16', 'name': '龙眠圣殿', 'giver': 'npc_dragon_elder', 'desc': '古龙·奥瑞斯知道深渊的秘密，击败他，得知真相', 'objective': {'kill': '古龙·奥瑞斯', 'count': 1}, 'reward_exp': 20000, 'reward_gold': 8000, 'next': 'q17', 'story': "龙眠圣殿，古龙·奥瑞斯盘踞在骸骨之上，声音像山崩：『上一次深渊战争，我们付出七位龙王的代价才将恶魔封印。如今封印将破，而凡间……竟已忘了如何战斗。』", 'ending': "奥瑞斯将一片龙鳞按进你掌心：『带着它去古战场回廊。魔王的『先锋』只是试探，真正的大军，正在裂缝之后列阵。』"},
    {'id': 'q17', 'name': '裂缝之后', 'giver': 'npc_void_prophet', 'desc': '魔王只是先锋，前往古战场回廊，寻找真正的敌人', 'objective': {'explore': 'void_corridor'}, 'reward_exp': 25000, 'reward_gold': 10000, 'next': 'q18', 'story': "古战场回廊，虚空先知·默坐在残破的石碑上：『千年了，这里埋葬着上一次战争的英魂。裂缝在扩大，裂隙巨兽每七日破壁而出。你来得正是时候——今天，是第七日。』", 'ending': "裂隙巨兽的残骸在回廊中燃烧。默望着裂缝深处：『旧教团的大祭司在召唤深渊真正的主人。他们的祭坛，藏在暗影与白骨之间。』"},
    {'id': 'q18', 'name': '战场中心', 'giver': 'npc_void_prophet', 'desc': '击败裂隙巨兽，粉碎战场中心', 'objective': {'kill': '裂隙巨兽', 'count': 1}, 'reward_exp': 30000, 'reward_gold': 12000, 'next': 'q19', 'story': "旧教团遗址，堕落祭司·法尔蹲在残垣上，黑袍下露出森白的骨指：『审判官在猎杀一切知情者，教团要重新打开深渊之门。你能活着走到这里，已经让我很惊讶了。』", 'ending': "审判官的长袍下空无一物——他早已是傀儡。法尔望着祭坛方向：『大祭司克劳斯在主持最后一场献祭。他要用一整个城市的人命，喂饱深渊。』"},
    {'id': 'q19', 'name': '教团的阴影', 'giver': 'npc_fallen_priest', 'desc': '旧教团遗址的审判官正在抓捕反抗者，击败他', 'objective': {'kill': '审判官', 'count': 1}, 'reward_exp': 36000, 'reward_gold': 14000, 'next': 'q20', 'story': "祭坛外围，腥风扑面。法尔的声音从阴影中传来：『克劳斯疯了，他把自己的血肉也献祭了。你若再不去，远境城就会成为下一座黑石城。』", 'ending': "大祭司克劳斯的黑袍塌陷下去，露出一具空壳。但献祭已经完成大半——你看见北方亡灵大军的方向，黑云正在集结。"},
    {'id': 'q20', 'name': '旧教团祭坛', 'giver': 'npc_fallen_priest', 'desc': '大祭司·克劳斯在召唤深渊真正的主人，阻止仪式', 'objective': {'kill': '大祭司·克劳斯', 'count': 1}, 'reward_exp': 43000, 'reward_gold': 17000, 'next': 'q21', 'story': "前线哨塔，斥候·鸦羽递给你一枚染血的骨片：『亡灵大军在集结，白骨君王亲征。它们的目标不是城市，是失落王都——那里埋着上古的兵器。』", 'ending': "枯骨先锋在箭雨中碎成粉末。鸦羽望着地平线上漫来的白骨潮：『君王来了。守城战，开始了。』"},
    {'id': 'q21', 'name': '大军压境', 'giver': 'npc_annih_spy', 'desc': '亡灵大军即将总攻，击败枯骨先锋，挫其锐气', 'objective': {'kill': '枯骨先锋', 'count': 1}, 'reward_exp': 50000, 'reward_gold': 20000, 'next': 'q22', 'story': "白骨战场，亡灵大军如潮水般涌来。斥候·鸦羽拔出断刀：『白骨君王麾下百万亡灵，我们只有一道城墙。但只要你斩了那个王，骷髅就会自己散架。』", 'ending': "白骨君王的王冠滚落在尸堆中，亡灵大军如退潮般溃散。鸦羽喘着气笑了：『好家伙……但星象师说，真正的黑手还在王都深处。』"},
    {'id': 'q22', 'name': '白骨君王', 'giver': 'npc_annih_spy', 'desc': '击败白骨君王，瓦解亡灵大军的指挥', 'objective': {'kill': '白骨君王', 'count': 1}, 'reward_exp': 60000, 'reward_gold': 24000, 'next': 'q23', 'story': "王国古道，古国守望者·星守望着残破的星图：『失落王城之下，封印着巫王·莫里斯——上一次深渊战争的元凶。他若挣脱封印，这世界将再无黎明。』", 'ending': "王家骑士长的石像在剑下崩裂。星守指着古道尽头：『门就在那里。推开它，你就要面对一个沉睡千年的君王了。』"},
    {'id': 'q23', 'name': '王都的传说', 'giver': 'npc_star_warden', 'desc': '古国守望者带来了预言：前往王国古道，踏上通往失落王城之路', 'objective': {'explore': 'divine_path'}, 'reward_exp': 70000, 'reward_gold': 28000, 'next': 'q24', 'story': "王国古道入口，古国守望者·星守摊开一张残破的星图：『星象紊乱，指针尽数指向失落王城。千年前的预言应验了——深渊的第二次进攻，将从王都的废墟下开始。』", 'ending': "你站在王国古道的尽头，望着远处灰雾中若隐若现的城墙。星守的声音在风中传来：『王家骑士长守在门前，那是最后的障碍了。』"},
    {'id': 'q24', 'name': '王国古道', 'giver': 'npc_star_warden', 'desc': '击败王家骑士长，扫清王国古道的阻碍', 'objective': {'kill': '王家骑士长', 'count': 1}, 'reward_exp': 80000, 'reward_gold': 32000, 'next': 'q25', 'story': "王国古道中段，一具石像忽然裂开，露出甲胄下的空洞。一个古老的声音回荡：『吾乃王家骑士长，奉先王之名镇守此道。凡人，报上名来，证明你配踏入王城。』", 'ending': "王家骑士长的石像在剑下崩裂，碎片中散落出一枚古旧的王城徽记。星守俯身拾起：『拿着它，王城之门才会为你敞开。』"},
    {'id': 'q25', 'name': '门扉之后', 'giver': 'npc_star_warden', 'desc': '失落王城之门近在眼前，前往失落王城之门', 'objective': {'explore': 'divine_gate'}, 'reward_exp': 90000, 'reward_gold': 36000, 'next': 'q26', 'story': "失落王城之门，两扇青铜巨门上刻满封印符文。星守将王城徽记按入门上的凹槽：『门后就是失落王城。千年来无人踏足，也无人活着出来。你，想好了吗？』", 'ending': "青铜巨门在轰鸣中缓缓开启，门内涌出积攒千年的腐朽气息。你握紧武器，迈步走进门后的黑暗。"},
    {'id': 'q26', 'name': '失落王城之门', 'giver': 'npc_star_warden', 'desc': '击败王城守望者，推开失落王城的大门', 'objective': {'kill': '王城守望者', 'count': 1}, 'reward_exp': 95000, 'reward_gold': 38000, 'next': 'q27', 'story': "失落王城之门内，王城守望者·石心矗立在大殿入口，浑身覆盖着活化的青铜：『先王有令，擅闯王城者，斩。千年来我已斩过无数亡灵，你是第一个活人。』", 'ending': "王城守望者的青铜身躯轰然碎裂，露出核心处一枚跳动的光核——那是先王最后的祝福。光核没入你体内，温暖的力量涌遍全身。"},
    {'id': 'q27', 'name': '先王庭院', 'giver': 'npc_last_god', 'desc': '先王被侵蚀，击败先王使者，解放庭院', 'objective': {'kill': '先王使者', 'count': 1}, 'reward_exp': 110000, 'reward_gold': 45000, 'next': 'q28', 'story': "先王庭院，枯败的蔷薇爬满石柱。一个苍老的声音在风中响起：『我是最后的古神残影。巫王·莫里斯用我的血染红了王座——你若能终结他，我愿以最后的神力为你祝福。』", 'ending': "先王使者化作光尘消散。古神残影的声音带着欣慰：『王座大殿就在前方。孩子，这是我最后一次为你指路了。』"},
    {'id': 'q28', 'name': '王座大殿', 'giver': 'npc_last_god', 'desc': '巫王·莫里斯盘踞王座大殿，击败他，拯救王国', 'objective': {'kill': '巫王·莫里斯', 'count': 1}, 'reward_exp': 130000, 'reward_gold': 52000, 'next': 'q29', 'story': "王座大殿，巫王·莫里斯缓缓抬头。他看起来只是个瘦削的老人，但眼中的黑暗深不见底：『一千年了，终于有人走到这里。你是来继承我的王位，还是来送死？』", 'ending': "巫王·莫里斯的王座崩裂，他的身影却没有消散，而是缓缓沉入地面：『你以为结束了？不……你只是唤醒了我真正的形态。』地面裂开，露出一座陷落的地下王都。"},
    {'id': 'q29', 'name': '陷落王都', 'giver': 'npc_last_god', 'desc': '巫王倒下之处裂开陷落王都，前往王都废墟', 'objective': {'explore': 'chaos_depths'}, 'reward_exp': 145000, 'reward_gold': 58000, 'next': 'q30', 'story': "陷落王都，天空被灰色的雾笼罩。古神残影的最后一丝声音在你耳边回响：『巫王只是影子，真正的黑暗在更深处——那是深渊第一次睁开眼的记忆。』", 'ending': "你在陷落王都的最深处停下脚步。前方是无光之域，而黑暗中，有什么东西正在缓缓睁开眼。"},
    {'id': 'q30', 'name': '巫王之影', 'giver': 'npc_last_god', 'desc': '击败巫王之影，终结第一次深渊战争之前的古老意志', 'objective': {'kill': '巫王之影', 'count': 1}, 'reward_exp': 200000, 'reward_gold': 80000, 'next': None, 'story': "无光之域，所有声音都消失了。黑暗中浮现出巫王之影——它是巫王被深渊吞噬后留下的残骸，也是深渊本体投射到凡间的第一缕意志。『千年前，众神将我的记忆封印于此。现在，轮到你了。』", 'ending': "巫王之影在无光之域崩解。当最后一丝黑暗散去，你听见整个维斯特兰的风都安静了一瞬——仿佛世界终于呼出了那口憋了千年的气。古神残影的声音最后一次响起：『英雄，你的名字将被永远铭记。』"},
]

