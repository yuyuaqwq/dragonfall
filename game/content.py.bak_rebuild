     "desc": "脚程极快的良种骏马，跑商赶路两不误。传送费 -20%（精英掉落『骏马缰绳』）"},
    {"key": "mount_wolf",   "name": "雪狼",  "icon": "🐺", "lv": 30, "price": 0,  "discount": 0.30, "elite_bonus": 0.05, "boss_bonus": 0.0,
     "desc": "北境驯化的雪狼，嗅觉灵敏专挑厉害的打。传送费 -30%，探索精英率 +5%（Boss 掉落『雪狼缰绳』）"},
]
MOUNT_BY_KEY = {m["key"]: m for m in MOUNT_POOL}

# 缰绳物品模板（精英/Boss 掉落）
def make_mount_rein(mount_key):
    m = MOUNT_BY_KEY[mount_key]
    return {"name": f"{m['name']}缰绳", "type": "坐骑", "mount_key": mount_key, "stackable": True,
            "price": 300, "desc": f"使用后可获得坐骑『{m['name']}』"}

# 坐骑缰绳掉落表：精英/Boss 按角色掉落（角色→候选坐骑）
MOUNT_DROP_ELITE = {"mount_steed": 0.06}   # 精英 6% 掉骏马缰绳
MOUNT_DROP_BOSS = {"mount_wolf": 0.10}     # Boss 10% 掉雪狼缰绳

def roll_mount_drop(role: str) -> str | None:
    """战斗胜利按怪物角色掷坐骑缰绳掉落，返回 mount_key 或 None"""
    tbl = MOUNT_DROP_BOSS if role == "boss" else (MOUNT_DROP_ELITE if role == "elite" else None)
    if not tbl:
        return None
    for mk, prob in tbl.items():
        if random.random() < prob:
            return mk
    return None

