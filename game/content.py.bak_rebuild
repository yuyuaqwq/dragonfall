# -*- coding: utf-8 -*-
"""
《剑与魔法》游戏内容库 v2.0 —— 公式驱动，策划支持 100 级
============================================================
架构说明：
- 怪物/装备属性全部由【公式 + 模板】生成，不手写每条数据
- 新增地图 = 在 MAPS 加一行；新增怪物 = 在模板池选型
- 当前实现 1-30 级内容（第 1-3 篇章），31-100 级按同架构扩展
世界观：维斯特兰大陆 —— 六大势力交错，剑与魔法并行。
"""

import random
from pypinyin import lazy_pinyin

# ============================================================
# 〇·A、ID 体系（v46 重构）—— 名字与 ID 分离，存档只存 ID
# ============================================================
# 核心思想：
#   - 内容表（MATERIALS/CRAFT_RECIPES/...）key 保持可读中文名（代码层）
#   - 每个实体映射一个稳定拼音 id（狼皮 → mat_lang_pi）
#   - 玩家存档（db）只存 id，显示时用 id→名字 翻译
#   - 以后改显示名 = 只改内容表 name，存档零迁移
# 提供：
#   - pinyin_id(name)          : 中文名 → 拼音 id（小写+下划线）
#   - build_index(table)       : 从「key=名字」的表构建 ID 索引
#   - resolve(table, name_or_id): 名字或 id → id（存档用）
#   - display(table, entity_id): id → 显示名
_INDEXES = {}   # 表名 → {"name_to_id": {}, "id_to_name": {}}

def pinyin_id(name: str) -> str:
    """中文名 → 拼音 id：狼皮 → lang_pi；保留字母/数字"""
    parts = []
    for ch in name:
        if '\u4e00' <= ch <= '\u9fff':
            parts.append(lazy_pinyin(ch)[0])
        elif ch.isalnum() or ch == '_':
            parts.append(ch.lower())
    return "_".join(parts)


def build_index(table_name: str, table: dict, prefix: str = "", name_field: str = None):
    """从表构建 名字↔id 双向索引。
    table: 内容表（key 即显示名，或 value[name_field] 为显示名）
    prefix: id 前缀（如 mat_ / sk_ / rec_），无则直接用 pinyin_id
    name_field: 若 value 是 dict 且含该字段，用 value[name_field] 做显示名；
                否则 key 本身即显示名。
    """
    n2i, i2n = {}, {}
    for k, v in table.items():
        if name_field and isinstance(v, dict) and v.get(name_field):
            nm = v[name_field]
        else:
            nm = k
        eid = f"{prefix}{pinyin_id(nm)}" if prefix else pinyin_id(nm)
        # 冲突时 id 保持稳定：若已存在同名 id，追加后缀
        if eid in i2n and i2n[eid] != nm:
            eid = f"{eid}_{len(i2n) + 1}"
        n2i[nm] = eid
        i2n[eid] = nm
    _INDEXES[table_name] = {"name_to_id": n2i, "id_to_name": i2n}


def resolve(table_name: str, name_or_id: str):
    """统一解析：输入名字或 id，都返回 id（找不到原样返回）"""
    idx = _INDEXES.get(table_name, {}).get("name_to_id", {})
    return idx.get(name_or_id, name_or_id)


def display(table_name: str, entity_id: str):
    """id → 显示名（找不到原样返回）"""
    idx = _INDEXES.get(table_name, {}).get("id_to_name", {})
    return idx.get(entity_id, entity_id)

# ============================================================
# 〇、基础数值公式（策划核心）
# ============================================================
def monster_stats(lv: int, role: str) -> dict:
    """怪物属性公式：按等级 + 角色模板生成。
    role: tank(血牛) / dps(攻高) / caster(魔攻) / speedster(敏捷) / boss(首领) / elite(精英)
    """
    base = {
        "tank":       {"hp": 60,  "atk": 8,  "def": 7,  "matk": 3,  "mdef": 6,  "spd": 6},
        "dps":        {"hp": 45,  "atk": 12, "def": 4,  "matk": 4,  "mdef": 4,  "spd": 10},
        "caster":     {"hp": 40,  "atk": 5,  "def": 3,  "matk": 14, "mdef": 8,  "spd": 9},
        "speedster":  {"hp": 35,  "atk": 9,  "def": 3,  "matk": 5,  "mdef": 4,  "spd": 16},
        "elite":      {"hp": 95,  "atk": 14, "def": 8,  "matk": 10, "mdef": 8,  "spd": 11},
        "boss":       {"hp": 160, "atk": 16, "def": 10, "matk": 12, "mdef": 10, "spd": 10},
    }[role]
    growth = {
        "tank":       {"hp": 20,  "atk": 2.5, "def": 1.6, "matk": 0.8, "mdef": 1.4, "spd": 0.3},
        "dps":        {"hp": 15,  "atk": 3.5, "def": 2.0, "matk": 1.0, "mdef": 1.2, "spd": 1.0},
        "caster":     {"hp": 11,  "atk": 1.2, "def": 1.0, "matk": 3.5, "mdef": 2.2, "spd": 0.9},
        "speedster":  {"hp": 10,  "atk": 2.6, "def": 1.0, "matk": 1.0, "mdef": 1.0, "spd": 1.8},
        "elite":      {"hp": 32,  "atk": 5.5, "def": 2.8, "matk": 4.5, "mdef": 2.8, "spd": 1.5},
        "boss":       {"hp": 58,  "atk": 7.5, "def": 3.8, "matk": 6.0, "mdef": 3.4, "spd": 1.8},
    }[role]
    stats = {}
    for k in base:
        stats[k] = int(base[k] + growth[k] * (lv - 1))
    # 首领/精英血量系数按等级段放大，保证后期 Boss 有压迫感
    if role == "boss":
        stats["hp"] = int(stats["hp"] * (1 + lv * 0.06))
    if role == "elite":
        stats["hp"] = int(stats["hp"] * (1 + lv * 0.04))
    return stats


def equip_stats(slot: str, lv: int, quality: str) -> dict:
    """装备属性公式：部位 + 装备等级 + 品质 → 属性字典"""
    mult = QUALITY[quality]["mult"]
    base = {
        "weapon":   {"atk": 3,  "matk": 3},
        "helm":     {"def": 2,  "hp": 8},
        "armor":    {"def": 4,  "hp": 15},
        "legs":     {"def": 3,  "hp": 10},
        "boots":    {"def": 1,  "spd": 2},
        "ring":     {"atk": 1,  "matk": 1},
        "necklace": {"mdef": 2, "hp": 6},
    }[slot]
    scaling = {
        "weapon":   {"atk": 1.0, "matk": 1.0},
        "helm":     {"def": 0.5, "hp": 3},
        "armor":    {"def": 0.9, "hp": 6},
        "legs":     {"def": 0.65, "hp": 4},
        "boots":    {"def": 0.4, "spd": 0.5},
        "ring":     {"atk": 0.35, "matk": 0.35},
        "necklace": {"mdef": 0.6, "hp": 2.5},
    }[slot]
    stats = {}
    for k in base:
        stats[k] = int((base[k] + scaling[k] * lv) * mult)
    if slot in ("weapon", "ring") and quality in ("蓝", "紫", "橙"):
        stats["crit"] = round((0.02 + 0.01 * lv / 10) * (QUALITY[quality]["mult"] - 1), 3)
    if slot == "necklace" and quality in ("蓝", "紫", "橙"):
        stats["mdef"] += int(3 * mult)
    return stats


def exp_to_next(level: int) -> int:
    """升到下一级所需经验（v28 校准：系数 35→60，升级节奏放缓）"""
    return int(60 * level ** 1.45 + 50)


def monster_exp(lv: int, role: str) -> int:
    """怪物经验公式（v28 校准：base 下调，配合等级差惩罚）"""
    base = {"tank": 8, "dps": 9, "caster": 10, "speedster": 9, "elite": 24, "boss": 60}[role]
    return int(base * (1 + lv * 0.9))


def monster_gold(lv: int, role: str) -> int:
    """怪物金币公式"""
    base = {"tank": 5, "dps": 6, "caster": 6, "speedster": 6, "elite": 20, "boss": 60}[role]
    return int(base * (1 + lv * 0.6))


