MAP_BY_ID = {m["id"]: m for m in MAPS}

# ============================================================
# 百科索引（v33）：材料→掉落来源、怪物→地图、地图→怪物
# ============================================================
ENCY_MATERIAL_SOURCE = {}   # 材料名 → [(地图名, 怪物名), ...]
ENCY_MONSTER_MAP = {}       # 怪物名 → [(地图名, 类型), ...]
ENCY_MAP_MONSTERS = {}      # 地图名 → [(怪物名, 等级, 类型), ...]


def _build_ency():
    for m in MAPS:
        mname = m["name"]
        entries = []
        for (mid, mstr, role, lv, skills, drops) in (m.get("monsters") or []):
            ENCY_MONSTER_MAP.setdefault(mstr, []).append((mname, "普通"))
            for d in drops:
                ENCY_MATERIAL_SOURCE.setdefault(d, []).append((mname, mstr))
            entries.append((mstr, lv, "普通"))
        if m.get("elite"):
            (eid, estr, erole, elv, eskl, edrops) = m["elite"]
            ENCY_MONSTER_MAP.setdefault(estr, []).append((mname, "精英"))
            for d in edrops:
                ENCY_MATERIAL_SOURCE.setdefault(d, []).append((mname, estr))
            entries.append((estr, elv, "精英"))
        if m.get("boss"):
            (bid, bstr, brole, blv, bskl, bdrops) = m["boss"]
            ENCY_MONSTER_MAP.setdefault(bstr, []).append((mname, "首领"))
            for d in bdrops:
                ENCY_MATERIAL_SOURCE.setdefault(d, []).append((mname, bstr))
            entries.append((bstr, blv, "首领"))
        ENCY_MAP_MONSTERS[mname] = entries


_build_ency()

# 区域定义：区域 id → 子区域 id 列表（用于地图视图分组）
MAP_AREAS = {}
for _m in MAPS:
    _aid = _m.get("area", _m["id"])
    MAP_AREAS.setdefault(_aid, []).append(_m["id"])
